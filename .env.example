# Environment Configuration for Chong Music
APP_ENV=development
API_PORT=8000
WEB_PORT=5173
HOST=0.0.0.0

# Database (Leave empty for built-in high performance SQLite persistence)
MONGODB_URI=
DATABASE_TYPE=sqlite
DATABASE_PATH=apps/api/data/chong.db

# Security & Session
SESSION_SECRET=chong-music-super-secret-key-change-in-production-2026

# YouTube Music Optional Auth Path (defaults to apps/api/data/browser.json if present)
YTMUSIC_AUTH_PATH=apps/api/data/browser.json

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
